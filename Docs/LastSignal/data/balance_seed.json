  "fuel_model": {
    "distance_cost": "(forward_or_reverse_travel_m / (nominal_range_km * 1000)) * stock_capacity * load_factor * boost_factor",
    "load_factor": "clamp(1 + 0.10 * (current_mass / stock_mass - 1), 0.90, 1.30)",
    "boost_factor_when_active": 1.7,
    "boost_factor_otherwise": 1,
    "idle_units_per_second": 0.003,
    "fuel_pickup_units": 5,
    "note": "Wheel travel burns fuel but route progress is separately monotonic. Nominal range assumes stock mass, no boost and excludes idle. Fuel capacity upgrades extend range; do not recompute distance cost from upgraded capacity. Guarantee a pickup before an otherwise marginal next leg."
  },
